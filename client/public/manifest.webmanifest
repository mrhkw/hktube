{
  "name": "HkTube — Watch. Create. Grow.",
  "short_name": "HkTube",
  "id": "/",
  "description": "HkTube — discover videos, watch Clips, follow creators and publish your own content.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0b0f19",
  "theme_color": "#111625",
  "categories": ["video", "social", "entertainment"],
  "shortcuts": [
    { "name": "Watch Shorts", "short_name": "Shorts", "url": "/shorts", "icons": [{ "src": "/hktube-icon.svg", "sizes": "any" }] },
    { "name": "Trending", "short_name": "Trending", "url": "/trending", "icons": [{ "src": "/hktube-icon.svg", "sizes": "any" }] },
    { "name": "Create", "short_name": "Create", "url": "/upload", "icons": [{ "src": "/hktube-icon.svg", "sizes": "any" }] }
  ],
  "icons": [{ "src": "/hktube-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }],
  "prefer_related_applications": false
}
