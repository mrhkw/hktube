{
  "version": 2,
  "buildCommand": "if [ -n \"$DATABASE_URL\" ]; then pnpm db:push; fi && pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(js|css|woff2|png|jpg|jpeg|webp|avif|gif|svg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30, "memory": 1024 },
    "api/storage.js": { "maxDuration": 60, "memory": 1024 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/manus-storage/(.*)", "dest": "/api/storage?path=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
