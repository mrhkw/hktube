{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/manus-storage/(.*)", "dest": "/api/storage?path=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
