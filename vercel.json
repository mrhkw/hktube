{
  "version": 2,
  "buildCommand": "if [ -n \"$DATABASE_URL\" ]; then pnpm db:push; fi && pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/manus-storage/(.*)", "dest": "/api/storage?path=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
