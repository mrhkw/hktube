# Server-side secrets: configure these in Vercel Project Settings > Environment Variables.
# Never commit a real .env file, API key, or service-role key.
# Groq is preferred when configured; Gemini remains the free-provider fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing client build variables (public values, not secrets)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
